# FAVELLA DEVELOPMENT - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to the repository.

# -------------------------------------------------------
# REQUIRED: Anthropic API key for AI agent responses
# Get from: https://console.anthropic.com/
# -------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# -------------------------------------------------------
# REQUIRED FOR DEPLOY: GitHub Personal Access Token
# Scopes needed: repo (read + write), workflow
# Get from: https://github.com/settings/tokens
# -------------------------------------------------------
GITHUB_TOKEN=ghp_your-token-here

# -------------------------------------------------------
# REQUIRED FOR DEPLOY: Your GitHub repository details
# Format: owner/repo-name (e.g. myorg/favella-development)
# -------------------------------------------------------
GITHUB_REPO=your-org/favella-development

# -------------------------------------------------------
# OPTIONAL: Deployment safety setting
# Set to "false" to allow agents to push directly to main.
# Set to "true" (default) to require a PR for every deploy.
# -------------------------------------------------------
REQUIRE_HUMAN_APPROVAL=true

# -------------------------------------------------------
# OPTIONAL: Default branch for deployments
# -------------------------------------------------------
GITHUB_DEFAULT_BRANCH=main

# -------------------------------------------------------
# OPTIONAL: Claude model selection
# claude-opus-4-5-20251101  = highest capability
# claude-sonnet-4-20250514  = fast + capable (default)
# -------------------------------------------------------
CLAUDE_MODEL=claude-sonnet-4-20250514
